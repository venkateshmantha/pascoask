# Anthropic (for enrichment + answer generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (for embeddings only - text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # leave blank for local Docker

# Collection name
QDRANT_COLLECTION=pasco_chunks

# SQLite path
SQLITE_DB_PATH=./data/pascoask.db

# Data directories
RAW_DATA_DIR=./data/raw
PDF_CACHE_DIR=./data/pdfs

# Scraping
REQUEST_DELAY_SECONDS=1.5              # be polite to county servers
MAX_CONCURRENT_REQUESTS=3

# Enrichment model
ENRICHMENT_MODEL=claude-opus-4-6
ANSWER_MODEL=claude-opus-4-6

# Logging
LOG_LEVEL=INFO
